@model IEnumerable<CS434_Nhom5.Models.RentalOrder>

@{
    ViewData["Title"] = "Quản lý đơn thuê";
}

<div class="container mt-4">
    <h2 class="text-primary fw-bold mb-4">Quản lý đơn thuê</h2>

    <form asp-action="Index" method="get" class="row g-3 mb-4 align-items-center">
        <div class="col-md-6">
            <input type="text" name="searchString" class="form-control" 
                   placeholder="Tìm kiếm theo khách hoặc mã đơn..." 
                   value="@ViewBag.CurrentFilter" />
        </div>

        <div class="col-md-4">
            <select name="statusFilter" class="form-select">
                <option value="All" selected="@(ViewBag.CurrentStatus == "All" ? "selected" : null)">Tất cả trạng thái</option>
                <option value="Pending" selected="@(ViewBag.CurrentStatus == "Pending" ? "selected" : null)">Đang xử lý</option>
                <option value="Confirmed" selected="@(ViewBag.CurrentStatus == "Confirmed" ? "selected" : null)">Đã xác nhận</option>
                <option value="Cancelled" selected="@(ViewBag.CurrentStatus == "Cancelled" ? "selected" : null)">Đã hủy</option>
            </select>
        </div>

        <div class="col-md-2">
            <button type="submit" class="btn btn-primary w-100">Tìm kiếm</button>
        </div>
    </form>

    <div class="card shadow-sm border-0">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-primary text-white">
                <tr>
                    <th>Mã đơn</th>
                    <th>Khách hàng</th>
                    <th>Xe</th>
                    <th>Nhận xe</th>
                    <th>Trả xe</th>
                    <th>Chi nhánh</th>
                    <th>Tổng tiền</th>
                    <th>Trạng thái</th>
                    <th class="text-center">Hành động</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-bold">@item.OrderCode</td>
                        <td>@item.CustomerName</td>
                        <td>@item.BikeModel</td>
                        <td>@item.PickupDate.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@item.ReturnDate.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@item.BranchRoute</td>
                        <td class="text-primary fw-bold">@item.TotalAmount.ToString("N0") đ</td>
                        <td>
                            @if (item.Status == "Pending")
                            {
                                <span class="badge bg-warning text-dark">Đang xử lý</span>
                            }
                            else if (item.Status == "Confirmed")
                            {
                                <span class="badge bg-success">Đã xác nhận</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Đã hủy</span>
                            }
                        </td>
                        <td class="text-center">
                            <div class="d-flex justify-content-center gap-2">
                                <a href="#" class="btn btn-sm btn-primary">Xem</a>

                                @if (item.Status == "Pending")
                                {
                                    <form asp-action="Confirm" asp-route-id="@item.Id" method="post">
                                        <button type="submit" class="btn btn-sm btn-success">Xác nhận</button>
                                    </form>

                                    <form asp-action="Cancel" asp-route-id="@item.Id" method="post">
                                        <button type="submit" class="btn btn-sm btn-danger">Hủy</button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>